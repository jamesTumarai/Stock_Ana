{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ]; then exit 1; else exit 0; fi",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": [
        "dist/*.cjs",
        "dist/*.cjs.map",
        "agent/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    }
  ]
}
