rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Current investment thesis pointer
      match /theses/{ticker} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && (!('userId' in request.resource.data) || request.resource.data.userId == userId);
        allow delete: if request.auth != null && request.auth.uid == userId;

        // Immutable historical thesis revisions (append-only)
        match /revisions/{revisionId} {
          allow read: if request.auth != null && request.auth.uid == userId;
          allow create: if request.auth != null
            && request.auth.uid == userId
            && (!('userId' in request.resource.data) || request.resource.data.userId == userId);
          allow update: if false;
          allow delete: if false;
        }
      }

      // Tracked expectations
      match /expectations/{expectationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && (!('userId' in request.resource.data) || request.resource.data.userId == userId);
        allow update: if request.auth != null
          && request.auth.uid == userId
          && (!('userId' in request.resource.data) || request.resource.data.userId == userId)
          && (!('userId' in resource.data) || resource.data.userId == userId)
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['userId', 'ticker', 'expectationId', 'targetValue', 'targetPeriod', 'condition', 'origin', 'createdAt', 'sourceReportId']);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }
    match /reports/{reportId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && (('persistenceVersion' in resource.data && resource.data.persistenceVersion == 2
          && resource.data.persistenceState == 'saving'
          && request.resource.data.persistenceState == 'ready'
          && exists(/databases/$(database)/documents/reports/$(reportId)/sections/_manifest)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['persistenceState', 'savedAt']))
        || (request.resource.data.deletedByUserId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['deletedAt', 'deletedByUserId', 'deletedByVersion'])));
      allow delete: if false;

      // Immutable parts inherit ownership from the compact parent. No public reads.
      match /{partCollection}/{partId} {
        allow read: if request.auth != null
          && partCollection in ['sections', 'history', 'artifacts']
          && get(/databases/$(database)/documents/reports/$(reportId)).data.userId == request.auth.uid;
        allow create: if request.auth != null
          && partCollection in ['sections', 'history', 'artifacts']
          && get(/databases/$(database)/documents/reports/$(reportId)).data.userId == request.auth.uid
          && get(/databases/$(database)/documents/reports/$(reportId)).data.persistenceState == 'saving';
        allow update, delete: if false;
      }
    }
  }
}
