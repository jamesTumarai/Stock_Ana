# Create a local .env file and replace the placeholder with a Google AI Studio API key.
# Never commit the real key.
# On Vercel, add GEMINI_API_KEY in Project Settings > Environment Variables. A new deployment is required after env changes.
GEMINI_API_KEY=replace_with_your_google_ai_studio_api_key

# Optional: the Express server defaults to port 3000.
PORT=3001

# Public Firebase project identifier used by server-side ID-token verification.
FIREBASE_PROJECT_ID=stock-analyze-a89d0
