# Create a local .env file and replace the placeholder with a Google AI Studio API key.
# Never commit the real key.
# On Vercel, add GEMINI_API_KEY in Project Settings > Environment Variables. A new deployment is required after env changes.
GEMINI_API_KEY=replace_with_your_google_ai_studio_api_key

# Optional: the Express server defaults to port 3000.
PORT=3001

# Firebase Admin token verification project.
# Production currently uses stock-analyze-a89d0. If you use an isolated dev/staging
# Firebase project, set this to the same projectId as the complete VITE_FIREBASE_*
# client configuration below.
FIREBASE_PROJECT_ID=stock-analyze-a89d0

# Firebase client environment separation (optional, all-or-nothing).
# Leave ALL of these unset to preserve the historical production Firebase project
# and existing Authentication users/report history. To use a dev/staging Firebase
# project, set every required variable together. Partial overrides are rejected so
# the app never mixes fields from two Firebase projects.
#
# VITE_FIREBASE_API_KEY=replace_with_public_web_api_key
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=replace_with_sender_id
# VITE_FIREBASE_APP_ID=replace_with_web_app_id
# VITE_FIREBASE_MEASUREMENT_ID=replace_if_used

# AI API abuse controls are enforced per authenticated Firebase UID on each running server instance.
# Phase 4B defaults: Analyze 8/15m with 1 concurrent run; DCF assumptions 16/15m; metric insights 60/15m; TTS 30/15m.
